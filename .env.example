# Copy thành backend/.env rồi điền giá trị. Không commit file .env.

# Database
DATABASE_URL=postgresql+psycopg://mediflow:mediflow@localhost:5432/mediflow
TEST_DATABASE_URL=postgresql+psycopg://mediflow:mediflow@localhost:5432/mediflow_test

# Auth
JWT_SECRET=doi-gia-tri-nay
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
GUEST_COOKIE_SECRET=doi-gia-tri-nay

# LLM (đổi nhà cung cấp/model chỉ bằng 2 dòng này)
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=768

# Giới hạn tin nhắn trợ lý mỗi ngày
CHAT_DAILY_LIMIT_PER_USER=50
CHAT_DAILY_LIMIT_PER_GUEST=10
CHAT_DAILY_LIMIT_ALL_GUESTS=200

# Tài khoản mẫu do scripts/seed.py tạo (để trống mật khẩu thì không tạo)
SEED_CONSULTANT_EMAIL=tuvanvien@mediflow.test
SEED_CONSULTANT_PASSWORD=
SEED_CUSTOMER_EMAIL=khachhang@mediflow.test
SEED_CUSTOMER_PASSWORD=

# Frontend: địa chỉ backend cho rewrites /api/*
BACKEND_URL=http://localhost:8000
